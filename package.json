{
  "name": "dsh-guard",
  "private": true,
  "version": "0.2.1",
  "description": "DeepSeek Harness 的沙箱侧加固工具集：持久审计与文件回滚、可指定模型的自动审批。",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "selftest": "node packages/dsh-audit-rollback/test/selftest.mjs",
    "verify": "node tools/verify.mjs",
    "check-manifest": "node scripts/check-manifest.mjs",
    "pack:all": "node scripts/pack-all.mjs",
    "release:local": "npm run verify && npm run check-manifest && npm run pack:all"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cosmokit": "1.8.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "license": "MIT"
}
