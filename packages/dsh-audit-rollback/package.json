{
  "name": "dsh-audit-rollback",
  "displayName": "审计与回滚（audit ledger + rollback）",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent audit ledger + precise rollback for DeepSeek Harness file-tool edits: capture pre-edit bytes into a content-addressed store per turn, roll back offline via a standalone CLI.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./ledger": "./lib/ledger.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "audit-rollback": "scripts/audit-rollback.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/ledger.js",
    "scripts/audit-rollback.mjs",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/plugin-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-guard.git",
    "directory": "packages/dsh-audit-rollback"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "audit",
    "rollback",
    "undo",
    "ledger"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
