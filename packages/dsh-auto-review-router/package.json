{
  "name": "dsh-auto-review-router",
  "version": "0.3.0",
  "private": true,
  "description": "可指定模型的 Auto 审查：reviewer 路由来自插件配置，缺省回退当前会话。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/policy.js",
    "lib/context.js",
    "cordis.patch.yml",
    "README.zh.md",
    "lib/config.js",
    "lib/approval-history.js"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/plugin-smoke.mjs && node test/status.mjs && node test/navigation.mjs && node test/loader-settings.mjs && node test/pending-schema.mjs && node test/manual-config.mjs && node test/configured-model-picker.mjs && node test/settings.mjs && node test/history-ui.mjs && node test/approval-history.mjs && node test/manual-fallback.mjs && node test/lifecycle.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-guard.git",
    "directory": "packages/dsh-auto-review-router"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "auto-review",
    "approval",
    "router",
    "review"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
